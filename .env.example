# PostgreSQL (Neon, Render, локальный)
DATABASE_URL=postgresql://user:password@localhost:5432/faceattend

# Обязателен в production, минимум 32 символа: openssl rand -hex 32
JWT_SECRET=

# Пароль первого admin (только при пустой базе). Если не задан — генерируется и выводится в лог один раз
ADMIN_PASSWORD=

# Часовой пояс организации для дат/времени отметок
APP_TIMEZONE=Asia/Almaty

# Порог сходства лица (евклидово расстояние, меньше = строже), по умолчанию 0.45
FACE_MATCH_THRESHOLD=0.45

# Создать демо-пользователей head/manager при первом запуске
SEED_DEMO_USERS=false
